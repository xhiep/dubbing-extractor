# Dubbing Extractor Configuration

# Whisper Model (tiny, base, small, medium, large)
WHISPER_MODEL=base

# Source Language (auto-detect if empty)
SOURCE_LANGUAGE=

# Target Language for translation
TARGET_LANGUAGE=vi

# Output directory
OUTPUT_DIR=output

# Dubbing
ENABLE_DUB=true
DUB_MODE=clone
DUB_PRESET_VOICE=Bích Ngọc (Nữ - Miền Bắc)
DUB_REF_AUDIO=
DUB_REF_TEXT=
DUB_SOURCE_VOLUME=0.05
DUB_MIX_MODE=tat_goc
TTS_PREVIEW_TEXT=Xin chao, day la mau thu giong tieng Viet.

# FFmpeg paths (auto-detect if empty)
FFMPEG_PATH=
FFPROBE_PATH=

# Cookies file for yt-dlp
COOKIES_FILE=cookies.txt

# Debug mode
DEBUG=false

# Cache directories - LƯU TẤT CẢ TRONG PROJECT
XDG_CACHE_HOME=.cache
HF_HOME=.cache/huggingface
HUGGINGFACE_HUB_CACHE=.cache/huggingface/hub
TRANSFORMERS_CACHE=.cache/huggingface/transformers
TORCH_HOME=.cache/torch
PIP_CACHE_DIR=.cache/pip
UV_CACHE_DIR=.cache/uv
TEMP=.tmp
TMP=.tmp
TMPDIR=.tmp
